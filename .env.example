# ============================================================
# Socratic Tutor - Environment Configuration
# Copy this file to .env and fill in the values.
# Never commit the real .env file.
# ============================================================

# ---- LLM provider ----
# Required for live generation. Tools, guardrail heuristics, RAG and the whole
# test suite run without it; only the tutor generation node needs a model.
#
# Any OpenAI-compatible provider works. Set OPENAI_BASE_URL to use a free one
# instead of OpenAI. Uncomment ONE of the blocks below.
#
#   Groq (free tier, very fast)          https://console.groq.com
#     OPENAI_BASE_URL=https://api.groq.com/openai/v1
#     MODEL_NAME=llama-3.3-70b-versatile
#
#   Google Gemini (generous free tier)   https://aistudio.google.com
#     OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
#     MODEL_NAME=gemini-2.0-flash
#
#   OpenRouter (has :free models)        https://openrouter.ai
#     OPENAI_BASE_URL=https://openrouter.ai/api/v1
#     MODEL_NAME=meta-llama/llama-3.3-70b-instruct:free
#
#   Ollama (fully local, no key at all)  https://ollama.com
#     OPENAI_BASE_URL=http://localhost:11434/v1
#     MODEL_NAME=llama3.1:8b
#
# Leave OPENAI_BASE_URL empty to use OpenAI itself.
OPENAI_API_KEY=
OPENAI_BASE_URL=
MODEL_NAME=gpt-4o-mini
# Temperature for tutor generation (0.0 - 1.0)
MODEL_TEMPERATURE=0.2
# Seconds before an LLM call is abandoned
LLM_TIMEOUT_SECONDS=45

# ---- Embeddings / RAG ----
# Embedding backend: "openai" or "local".
# "local" uses a deterministic hashing embedder so RAG runs with no API key.
EMBEDDING_BACKEND=local
EMBEDDING_MODEL=text-embedding-3-small
# Vector database backend: "chroma" (default). Designed so "qdrant" can be added.
VECTOR_DB=chroma
CHROMA_PERSIST_DIR=data/chroma
CHROMA_COLLECTION=socratic_tutor
RAG_CHUNK_SIZE=1000
RAG_CHUNK_OVERLAP=150
RAG_TOP_K=4

# ---- Tutoring policy ----
# One of: STRICT, GUIDED, BALANCED, DIRECT
TUTOR_MODE=STRICT

# ---- Guardrails ----
# One of: STRICT, BALANCED, RESEARCH_DEMO
GUARDRAIL_POLICY=STRICT
# Use the LLM classifier layer for prompt-injection detection when a key exists.
INJECTION_LLM_CLASSIFIER=false
# Maximum output-guard regeneration attempts before falling back.
MAX_OUTPUT_RETRIES=2

# ---- Observability ----
LOG_LEVEL=INFO
# Emit logs as JSON lines instead of human-readable text.
LOG_JSON=true
# LangSmith tracing is optional and never required for local runs.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=socratic-tutor

# ---- API ----
API_HOST=0.0.0.0
API_PORT=8000
# Base URL the Streamlit frontend uses to reach the API.
BACKEND_URL=http://localhost:8000
